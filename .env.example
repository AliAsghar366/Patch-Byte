[TEMPLATE]
# Stripe keys - NEVER commit real values here. Set these in your hosting dashboard.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Supabase keys (move the existing hardcoded values here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Admin Portal (frontend/server.js) ─────────────────────────────────────
# Password used to sign in at /admin. If unset, falls back to the built-in default:
#   TahaRizvi1214 — the portal works without env setup. Override for real deploys.
ADMIN_PASSWORD=TahaRizvi1214

# Secret used to sign admin session tokens (HMAC). Optional — falls back to
# ADMIN_PASSWORD if unset. Rotate to invalidate all logged-in sessions.
ADMIN_TOKEN_SECRET=change-me-too

# SERVICE ROLE key from Supabase (Settings → API → service_role). This key
# bypasses Row Level Security, so it must ONLY live on the server (never in
# browser code). The admin portal reads/writes orders with it. If unset, the
# portal falls back to the public anon key and shows a warning banner.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
